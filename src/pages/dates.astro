---
import Layout from '../layouts/Layout.astro';
import Countdown from '../components/Countdown.astro';

const dates = [
  { event: "Paper Submission System Opens", date: "June 01, 2026", status: "Completed", isHighlight: false },
  { event: "Full Paper Submission Deadline", date: "October 15, 2026", status: "Active", isHighlight: true },
  { event: "Notification of Acceptance", date: "November 15, 2026", status: "Upcoming", isHighlight: false },
  { event: "Camera-Ready Paper Due", date: "November 30, 2026", status: "Upcoming", isHighlight: false },
  { event: "Registration Deadline", date: "December 05, 2026", status: "Upcoming", isHighlight: false },
  { event: "Conference Dates", date: "December 18-20, 2026", status: "Upcoming", isHighlight: true }
];
---

<Layout title="Important Dates" activePage="Important Dates">
  <!-- Top Banner -->
  <section class="bg-slate-50 border-b border-slate-200 py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="text-xs font-bold tracking-wider text-primary uppercase block mb-2">Timeline</span>
      <h1 class="text-3xl sm:text-4xl font-black text-slate-900 tracking-tight mb-4">Important Dates</h1>
      <p class="max-w-2xl mx-auto text-sm text-slate-600">
        Please note the key deadlines for paper submissions, reviews, registrations, and event schedules.
      </p>
    </div>
  </section>

  <!-- Content Section -->
  <section class="py-20 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="space-y-12">
      <!-- Countdown timer for nearest submission deadline -->
      <div>
        <Countdown targetDate="2026-10-15T23:59:59" title="Next Deadline: Paper Submission" />
      </div>

      <!-- Dates Table -->
      <div class="bg-white border border-slate-200 rounded-[6px] overflow-hidden shadow-sm">
        <div class="p-5 border-b border-slate-100 bg-slate-50">
          <h2 class="text-base font-bold text-slate-900 tracking-wide">Submission & Registration Deadlines</h2>
          <p class="text-xs text-slate-500 mt-1">Times are listed in Indian Standard Time (IST - UTC+5:30).</p>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="border-b border-slate-200 text-xs font-bold text-slate-500 uppercase bg-slate-50">
                <th class="px-6 py-3.5">Event</th>
                <th class="px-6 py-3.5">Deadline</th>
                <th class="px-6 py-3.5 text-right">Status</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 text-xs sm:text-sm">
              {dates.map((item) => (
                <tr class={`hover:bg-slate-50 transition-colors ${item.isHighlight ? 'bg-blue-50/40' : ''}`}>
                  <td class="px-6 py-4 font-semibold text-slate-900">
                    {item.event}
                    {item.isHighlight && <span class="ml-2 inline-flex items-center px-1.5 py-0.5 rounded text-[9px] font-bold bg-amber-100 text-amber-800 border border-amber-200">Critical</span>}
                  </td>
                  <td class="px-6 py-4 text-slate-700 font-medium">
                    {item.date}
                  </td>
                  <td class="px-6 py-4 text-right">
                    <span class={`inline-block px-2 py-0.5 rounded text-xs font-bold ${
                      item.status === 'Completed' ? 'bg-green-100 text-green-800 border border-green-200' :
                      item.status === 'Active' ? 'bg-blue-100 text-blue-800 border border-blue-200 animate-pulse' :
                      'bg-slate-100 text-slate-500 border border-slate-200'
                    }`}>
                      {item.status}
                    </span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <!-- Note Alert -->
      <div class="rounded-[4px] border border-blue-200 bg-blue-50/50 p-4 flex gap-3">
        <span class="text-primary font-bold text-sm select-none">ℹ</span>
        <p class="text-xs text-slate-600 leading-relaxed">
          <strong class="text-slate-800 block mb-0.5">Author Note:</strong>
          Any modifications or extensions to the submission dates will be broadcasted on the home page ticker and updated in the timeline table above. Plagiarism checks will run immediately after submission.
        </p>
      </div>
    </div>
  </section>
</Layout>
