---
import Layout from "../layouts/Layout.astro";

const hotels = [
  {
    name: "Sayaji Hotel Indore",
    rating: "5 Star",
    distance: "8.5 km from Venue",
    phone: "+91 731 4006666",
  },
  {
    name: "Radisson Blu Hotel Indore",
    rating: "5 Star",
    distance: "9.2 km from Venue",
    phone: "+91 731 6108888",
  },
  {
    name: "Ginger Hotel Indore",
    rating: "3 Star / Business",
    distance: "6.0 km from Venue",
    phone: "+91 731 6663333",
  },
  {
    name: "DAVV Takshashila Guest House",
    rating: "University Transit",
    distance: "On-Campus (Limited)",
    phone: "Available via Committee Desk",
  },
];
---

<Layout title="Venue & Travel" activePage="Venue & Travel">
  <!-- Top Banner -->
  <section class="bg-slate-50 border-b border-slate-200 py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span
        class="text-xs font-bold tracking-wider text-primary uppercase block mb-2"
        >Location</span
      >
      <h1
        class="text-3xl sm:text-4xl font-black text-slate-900 tracking-tight mb-4"
      >
        Venue & Accommodation
      </h1>
      <p class="max-w-2xl mx-auto text-sm text-slate-600">
        Discover directions to the IIPS Takshashila Campus and find nearby
        lodgings in Indore, India.
      </p>
    </div>
  </section>

  <!-- Content Section -->
  <section class="py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
      <!-- Directions info -->
      <div class="space-y-10">
        <div>
          <span
            class="text-xs font-bold tracking-wider text-primary uppercase block mb-2"
            >Getting Here</span
          >
          <h2
            class="text-xl sm:text-2xl font-extrabold text-slate-900 tracking-tight"
          >
            How to Reach the Venue
          </h2>
          <p class="text-xs sm:text-sm text-slate-500 mt-2">
            The conference will be hosted at the International Institute of
            Professional Studies (IIPS), Devi Ahilya Vishwavidyalaya, Indore
            (MP), India.
          </p>
        </div>

        <div class="space-y-6 text-xs sm:text-sm">
          <!-- By Air -->
          <div class="flex gap-4">
            <div
              class="w-9 h-9 rounded bg-blue-50 border border-blue-200 flex items-center justify-center text-primary shrink-0 font-bold"
            >
              ✈
            </div>
            <div>
              <h3 class="text-slate-900 font-bold text-sm tracking-wide">
                By Air
              </h3>
              <p class="text-xs text-slate-600 mt-1 leading-relaxed">
                **Devi Ahilyabai Holkar Airport (IDR)** is approximately 12 km
                from the Takshashila Campus. Pre-paid taxis and app-based cabs
                (Ola, Uber) are readily available outside the arrivals terminal.
              </p>
            </div>
          </div>

          <!-- By Rail -->
          <div class="flex gap-4">
            <div
              class="w-9 h-9 rounded bg-blue-50 border border-blue-200 flex items-center justify-center text-primary shrink-0 font-bold"
            >
              🚂
            </div>
            <div>
              <h3 class="text-slate-900 font-bold text-sm tracking-wide">
                By Train
              </h3>
              <p class="text-xs text-slate-600 mt-1 leading-relaxed">
                **Indore Junction Railway Station (INDB)** is about 5 km from
                the campus. Auto-rickshaws and local cabs are easily available
                from the platform exits.
              </p>
            </div>
          </div>

          <!-- By Road -->
          <div class="flex gap-4">
            <div
              class="w-9 h-9 rounded bg-blue-50 border border-blue-200 flex items-center justify-center text-primary shrink-0 font-bold"
            >
              🚗
            </div>
            <div>
              <h3 class="text-slate-900 font-bold text-sm tracking-wide">
                By Road
              </h3>
              <p class="text-xs text-slate-600 mt-1 leading-relaxed">
                Indore is well connected by major national highways (like NH-3)
                with inter-state bus services operating daily from Sarwate Bus
                Stand and Gangwal Bus Stand.
              </p>
            </div>
          </div>
        </div>

        <!-- Accommodation -->
        <div class="space-y-6">
          <div>
            <span
              class="text-xs font-bold tracking-wider text-primary uppercase block mb-2"
              >Accommodations</span
            >
            <h2
              class="text-xl font-extrabold text-slate-900 tracking-tight font-sans"
            >
              Recommended Hotels
            </h2>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {
              hotels.map((hotel) => (
                <div class="academic-card p-5 bg-white space-y-2">
                  <span class="inline-block px-2 py-0.5 rounded-[3px] text-[9px] font-bold bg-blue-50 text-primary border border-blue-100 uppercase">
                    {hotel.rating}
                  </span>
                  <h4 class="text-slate-900 font-bold text-xs tracking-wide">
                    {hotel.name}
                  </h4>
                  <p class="text-[10px] text-slate-500">{hotel.distance}</p>
                  <div class="text-[10px] text-slate-600 font-semibold mt-1">
                    Tel:{" "}
                    <span class="text-slate-800 font-mono select-all">
                      {hotel.phone}
                    </span>
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </div>

      <!-- Map & Campus info -->
      <div class="space-y-8 lg:sticky lg:top-24">
        <!-- Map Box -->
        <div
          class="bg-white border border-slate-200 rounded-[6px] overflow-hidden shadow-sm h-80 sm:h-96 relative"
        >
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3681.272186851608!2d75.87739507584518!3d22.68096352865207!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3962fce12d377b55%3A0xb308a0d927d3c015!2sInternational%20Institute%20of%20Professional%20Studies!5e0!3m2!1sen!2sin!4v1700000000000!5m2!1sen!2sin"
            class="w-full h-full border-0 absolute inset-0 opacity-90"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="IIPS DAVV Google Map"></iframe>
        </div>

        <div class="bg-slate-50 border border-slate-200 rounded-[6px] p-5">
          <h3
            class="text-slate-900 font-bold text-xs uppercase tracking-wider mb-2 border-b border-slate-200 pb-1.5"
          >
            Indore: The Cleanest City
          </h3>
          <p class="text-xs text-slate-600 leading-relaxed">
            Indore is the commercial capital of Madhya Pradesh and is widely
            recognized for holding the title of **India's Cleanest City**
            consecutively for multiple years. It features rich cultural
            monuments like the Rajwada Palace and Lal Bagh Palace and is famous
            for its delicious street food culture (Sarafa Bazar, Chappan Dukan).
          </p>
        </div>
      </div>
    </div>
  </section>
</Layout>
