---
import Layout from "../layouts/Layout.astro";
import Countdown from "../components/Countdown.astro";

const keynoteSpeakers = [
  {
    name: "Dr. Aradhana Gupta",
    role: "Professor & Head of AI Lab",
    institution: "IIT Bombay, India",
    topic: "Generative AI: The Next Frontier in Cyber-Physical Systems",
    image:
      "https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?auto=format&fit=crop&q=80&w=300&h=300",
  },
  {
    name: "Dr. Marcus Vance",
    role: "Principal Research Architect",
    institution: "Intel Labs, USA",
    topic:
      "Next-Gen Edge Computing architectures for Ultra-Reliable Low-Latency IoT",
    image:
      "https://images.unsplash.com/photo-1560250097-0b93528c311a?auto=format&fit=crop&q=80&w=300&h=300",
  },
  {
    name: "Dr. Sarah Jenkins",
    role: "Associate Professor, Cyber Security Institute",
    institution: "National University of Singapore",
    topic:
      "Post-Quantum Cryptography: Securing the Future of Decentralized Finance",
    image:
      "https://images.unsplash.com/photo-1580489944761-15a19d654956?auto=format&fit=crop&q=80&w=300&h=300",
  },
];

const highlights = [
  {
    title: "Conference Proceedings",
    desc: "All accepted and presented papers will be submitted for inclusion into IEEE Xplore subject to meeting IEEE's scope and quality requirements.",
  },
  {
    title: "Best Paper Awards",
    desc: "Separate best paper awards for academic tracks and student categories, presenting cash rewards and certificates.",
  },
  {
    title: "Expert Panels",
    desc: "Interactive panel discussions with industry captains and leading academicians on emerging tech policies and ethics.",
  },
];
---

<Layout title="Home" activePage="Home">

  <!-- Hero Section -->
  <section
    class="relative bg-slate-50 border-b border-slate-200 py-16 md:py-24"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <!-- Tag / Badge -->
      <div
        class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-[4px] bg-white border border-slate-200 text-xs font-bold text-slate-700 mb-6 shadow-sm"
      >
        <span class="w-2 h-2 rounded-full bg-[#00629B]"></span>
        <span>IEEE Technical Co-sponsorship (Applied)</span>
      </div>

      <!-- Main Title -->
      <h1
        class="text-3xl sm:text-5xl md:text-6xl font-extrabold tracking-tight text-slate-900 mb-4 leading-tight"
      >
        International Conference on<br />
        <span class="text-primary">Modern Emerging Technologies</span>
      </h1>

      <h2 class="text-xl sm:text-2xl font-bold text-slate-700 mb-6">
        (IIPS-CoMET 2026)
      </h2>

      <!-- Date & Location -->
      <p
        class="max-w-2xl mx-auto text-sm sm:text-base text-slate-600 font-medium mb-10 flex flex-col sm:flex-row items-center justify-center gap-2 sm:gap-6"
      >
        <span class="flex items-center gap-1.5">
          <svg
            class="w-4 h-4 text-primary"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
            ></path></svg
          >
          December 18-20, 2026
        </span>
        <span class="hidden sm:inline text-slate-300">|</span>
        <span class="flex items-center gap-1.5">
          <svg
            class="w-4 h-4 text-primary"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
            ></path></svg
          >
          IIPS, DAVV, Indore, India
        </span>
      </p>

      <!-- CTAs -->
      <div class="flex flex-wrap items-center justify-center gap-4 mb-12">
        <a
          href="/call-for-papers"
          class="px-6 py-3 bg-primary hover:bg-primary-dark text-white rounded-[4px] text-sm font-bold tracking-wide transition-all shadow-sm"
        >
          Submit Your Paper
        </a>
        <a
          href="/registration"
          class="px-6 py-3 bg-white hover:bg-slate-100 text-primary border border-primary rounded-[4px] text-sm font-bold tracking-wide transition-all shadow-sm"
        >
          Register for Event
        </a>
      </div>

      <!-- Countdown Wrapper -->
      <div class="max-w-2xl mx-auto">
        <Countdown
          targetDate="2026-10-15T23:59:59"
          title="Paper Submission Deadline Ends In"
        />
      </div>
    </div>
  </section>

  <!-- Highlight Cards Section -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {
          highlights.map((item) => (
            <div class="academic-card p-6 flex flex-col h-full bg-white">
              <h3 class="text-primary font-bold text-base mb-3 border-b border-slate-100 pb-2">
                {item.title}
              </h3>
              <p class="text-xs text-slate-600 leading-relaxed flex-grow">
                {item.desc}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- About Section -->
  <section
    class="py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 bg-slate-50 border-y border-slate-200"
  >
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      <!-- About Text -->
      <div class="space-y-5">
        <span
          class="text-xs font-bold tracking-wider text-primary uppercase block"
          >About The Conference</span
        >
        <h2
          class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight leading-tight"
        >
          Pioneering Research for Technological Breakthroughs
        </h2>
        <p class="text-slate-600 leading-relaxed text-sm">
          The **IEEE International Conference on Modern Emerging Technologies
          (IIPS-CoMET 2026)** is the flagship annual conference of the
          International Institute of Professional Studies, Devi Ahilya
          Vishwavidyalaya, Indore. The conference serves as a collaborative
          stage for researchers, academicians, industry professionals, and
          students.
        </p>
        <p class="text-slate-600 leading-relaxed text-sm">
          Our goal is to exchange novel concepts and experimental discoveries
          across key computing pillars: artificial intelligence, network
          communications, post-quantum cybersecurity, data architectures, and
          smart cyber-physical infrastructures.
        </p>

        <div class="pt-4 flex flex-wrap gap-8">
          <div class="border-l-2 border-primary pl-4">
            <span
              class="text-3xl font-extrabold text-primary tracking-tight block"
              >4</span
            >
            <span
              class="text-[10px] text-slate-500 font-bold uppercase tracking-wider"
              >Technical Tracks</span
            >
          </div>
          <div class="border-l-2 border-primary pl-4">
            <span
              class="text-3xl font-extrabold text-primary tracking-tight block"
              >15+</span
            >
            <span
              class="text-[10px] text-slate-500 font-bold uppercase tracking-wider"
              >Keynote Sessions</span
            >
          </div>
          <div class="border-l-2 border-primary pl-4">
            <span
              class="text-3xl font-extrabold text-primary tracking-tight block"
              >100+</span
            >
            <span
              class="text-[10px] text-slate-500 font-bold uppercase tracking-wider"
              >Accepted Papers</span
            >
          </div>
        </div>
      </div>

      <!-- About Graphics / Visual Card -->
      <div class="academic-card p-6 bg-white border border-slate-200">
        <h3
          class="text-primary font-bold text-sm uppercase tracking-wider mb-4 border-b border-slate-100 pb-2"
        >
          Host Institution
        </h3>
        <p class="text-xs text-slate-700 leading-relaxed mb-4">
          <strong
            >International Institute of Professional Studies (IIPS), DAVV</strong
          > is a premier business-computer study center established in 1992 under
          Devi Ahilya Vishwavidyalaya. It is known for running highly integrated professional
          programs in management and computer applications.
        </p>
        <div
          class="h-48 rounded bg-slate-100 border border-slate-200 flex flex-col justify-center items-center p-6 text-center"
        >
          <span
            class="text-[11px] text-slate-500 font-bold uppercase tracking-wider mb-1"
            >Takshashila Campus</span
          >
          <span class="text-slate-800 font-bold text-lg"
            >Devi Ahilya Vishwavidyalaya</span
          >
          <span class="text-xs text-primary font-semibold mt-1"
            >Indore, MP, India</span
          >
        </div>
      </div>
    </div>
  </section>

  <!-- Keynote Speakers -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16 space-y-3">
        <span
          class="text-xs font-bold tracking-wider text-primary uppercase block"
          >Keynotes</span
        >
        <h2
          class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight"
        >
          Distinguished Speakers
        </h2>
        <p class="text-slate-500 text-xs sm:text-sm">
          Hear from world-renowned researchers paving the way for innovations in
          artificial intelligence, hardware design, and cryptology.
        </p>
      </div>

      <!-- Speakers Grid -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {
          keynoteSpeakers.map((speaker) => (
            <div class="academic-card bg-white flex flex-col h-full overflow-hidden">
              <div class="h-56 bg-slate-100 relative overflow-hidden shrink-0 border-b border-slate-100">
                <img
                  src={speaker.image}
                  alt={speaker.name}
                  class="w-full h-full object-cover grayscale"
                />
              </div>
              <div class="p-5 flex-grow flex flex-col justify-between">
                <div class="space-y-2">
                  <span class="text-[10px] text-primary font-bold uppercase tracking-wider">
                    {speaker.role}
                  </span>
                  <h3 class="text-slate-900 font-bold text-base tracking-wide">
                    {speaker.name}
                  </h3>
                  <p class="text-xs text-slate-500 font-semibold">
                    {speaker.institution}
                  </p>
                  <div class="border-t border-slate-100 my-3" />
                  <p class="text-xs text-slate-600 leading-relaxed italic">
                    <strong>Talk title:</strong> "{speaker.topic}"
                  </p>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Layout>

