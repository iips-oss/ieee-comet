---
import Layout from "../layouts/Layout.astro";

const keynoteSpeakers = [
  {
    name: "Dr. Armen V. Papazian",
    role: "Financial Economist & Researcher",
    institution: "Value Space Research, United Kingdom",
    topic: "The Space Value of Money and Financial Ethics in Emerging Technologies",
    image: "/images/people/speaker/Dr.Armen_V.Papazian.jpg",
  },
  {
    name: "Mr. Ashish Limaye",
    role: "Business Transformation Architect",
    institution: "Industry Solutions Consultant, India",
    topic: "Enterprise Integration and Scalable IoT Architecture Deployment",
    image: "/images/people/speaker/Mr.AshishLimaye.jpg",
  },
  {
    name: "Mr. Vineet Saraiwala",
    role: "Founder & CEO, Aatmanirbhar",
    institution: "Accessibility Advocate, IIM Bangalore Alumnus",
    topic: "Accessibility Engineering and Inclusive Design in Modern Web Systems",
    image: "/images/people/speaker/Mr.VineetSaraiwala.jpg",
  },
];

const highlights = [
  {
    title: "Conference Proceedings",
    desc: "All accepted and presented papers will be submitted for inclusion into IEEE Xplore subject to meeting IEEE's scope and quality requirements.",
  },
  {
    title: "Best Paper Awards",
    desc: "Separate best paper awards for academic tracks and student categories, presenting cash rewards and certificates.",
  },
  {
    title: "Expert Panels",
    desc: "Interactive panel discussions with industry captains and leading academicians on emerging tech policies and ethics.",
  },
];
---

<Layout title="Home" activePage="Home">

  <!-- Hero Section -->
  <section class="relative bg-slate-50 text-slate-900 py-20 md:py-28 overflow-hidden border-b border-slate-200">
    <!-- Sliding Background Images -->
    <div class="absolute inset-0 z-0 overflow-hidden">
      <!-- Transparent White Overlays for visibility and readability -->
      <div class="absolute inset-0 bg-white/65 z-10"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-white/50 via-transparent to-white/30 z-10"></div>
      
      <!-- Slide 1 -->
      <div class="hero-slide absolute inset-0 opacity-100 transition-opacity duration-1000 ease-in-out">
        <img src="/images/campus/IIPS_college.jpg" alt="IIPS College" class="w-full h-full object-cover" />
      </div>
      <!-- Slide 2 -->
      <div class="hero-slide absolute inset-0 opacity-0 transition-opacity duration-1000 ease-in-out">
        <img src="/images/campus/DAVV_campus.jpg" alt="DAVV Campus" class="w-full h-full object-cover" />
      </div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-20">
      <!-- Tag / Badge -->
      <div
        class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-[4px] bg-white/85 border border-slate-200/80 backdrop-blur-sm text-xs font-bold text-slate-700 mb-6 shadow-sm"
      >
        <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
        <span>IEEE Technical Co-sponsorship (Applied)</span>
      </div>

      <!-- Main Title -->
      <h1
        class="text-3xl sm:text-5xl md:text-6xl font-extrabold tracking-tight text-slate-900 mb-4 leading-tight"
      >
        International Conference on<br />
        <span class="text-primary">Modern Emerging Technologies</span>
      </h1>

      <h2 class="text-xl sm:text-2xl font-bold text-slate-700 mb-6">
        (IIPS-CoMET 2026)
      </h2>

      <!-- Date & Location -->
      <p
        class="max-w-2xl mx-auto text-sm sm:text-base text-slate-650 font-semibold mb-10 flex flex-col sm:flex-row items-center justify-center gap-2 sm:gap-6"
      >
        <span class="flex items-center gap-1.5">
          <svg
            class="w-4 h-4 text-primary"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2.5"
              d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
            ></path></svg
          >
          December 18-20, 2026
        </span>
        <span class="hidden sm:inline text-slate-300">|</span>
        <span class="flex items-center gap-1.5">
          <svg
            class="w-4 h-4 text-primary"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2.5"
              d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
            ></path></svg
          >
          IIPS, DAVV, Indore, India
        </span>
      </p>

      <!-- CTAs -->
      <div class="flex flex-wrap items-center justify-center gap-4 mb-12">
        <a
          href="/call-for-papers"
          class="px-6 py-3 bg-primary hover:bg-primary-dark text-white rounded-[4px] text-sm font-bold uppercase tracking-wider transition-all shadow-sm"
        >
          Submit Your Paper
        </a>
        <a
          href="/registration"
          class="px-6 py-3 bg-white hover:bg-slate-50 text-primary border border-primary rounded-[4px] text-sm font-bold uppercase tracking-wider transition-all shadow-sm"
        >
          Register for Event
        </a>
      </div>

      <!-- Key Dates Quick Bar -->
      <div class="mt-8 text-xs sm:text-sm tracking-wide flex flex-wrap justify-center items-center gap-x-6 gap-y-2.5">
        <span class="flex items-center gap-1.5">
          <strong class="text-primary font-bold uppercase tracking-wider text-[11px] sm:text-xs">Draft Submission:</strong>
          <span class="text-slate-900 font-extrabold">October 15, 2026</span>
        </span>
        <span class="hidden sm:inline text-slate-300 font-extrabold">•</span>
        <span class="flex items-center gap-1.5">
          <strong class="text-primary font-bold uppercase tracking-wider text-[11px] sm:text-xs">Acceptance:</strong>
          <span class="text-slate-900 font-extrabold">November 10, 2026</span>
        </span>
        <span class="hidden sm:inline text-slate-300 font-extrabold">•</span>
        <span class="flex items-center gap-1.5">
          <strong class="text-primary font-bold uppercase tracking-wider text-[11px] sm:text-xs">Camera Ready:</strong>
          <span class="text-slate-900 font-extrabold">November 30, 2026</span>
        </span>
      </div>
    </div>
  </section>

  <!-- Highlight Cards Section -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {
          highlights.map((item) => (
            <div class="academic-card p-6 flex flex-col h-full bg-white">
              <h3 class="text-primary font-bold text-base mb-3 border-b border-slate-100 pb-2">
                {item.title}
              </h3>
              <p class="text-xs text-slate-600 leading-relaxed flex-grow">
                {item.desc}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- About Section -->
  <section
    class="py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 bg-slate-50 border-y border-slate-200"
  >
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      <!-- About Text -->
      <div class="space-y-5">
        <span
          class="text-xs font-bold tracking-wider text-primary uppercase block"
          >About The Conference</span
        >
        <h2
          class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight leading-tight"
        >
          Pioneering Research for Technological Breakthroughs
        </h2>
        <p class="text-slate-600 leading-relaxed text-sm">
          The **IEEE International Conference on Modern Emerging Technologies
          (IIPS-CoMET 2026)** is the flagship annual conference of the
          International Institute of Professional Studies, Devi Ahilya
          Vishwavidyalaya, Indore. The conference serves as a collaborative
          stage for researchers, academicians, industry professionals, and
          students.
        </p>
        <p class="text-slate-600 leading-relaxed text-sm">
          Our goal is to exchange novel concepts and experimental discoveries
          across key computing pillars: artificial intelligence, network
          communications, post-quantum cybersecurity, data architectures, and
          smart cyber-physical infrastructures.
        </p>

        <div class="pt-4 flex flex-wrap gap-8">
          <div class="border-l-2 border-primary pl-4">
            <span
              class="text-3xl font-extrabold text-primary tracking-tight block"
              >4</span
            >
            <span
              class="text-[10px] text-slate-500 font-bold uppercase tracking-wider"
              >Technical Tracks</span
            >
          </div>
          <div class="border-l-2 border-primary pl-4">
            <span
              class="text-3xl font-extrabold text-primary tracking-tight block"
              >15+</span
            >
            <span
              class="text-[10px] text-slate-500 font-bold uppercase tracking-wider"
              >Keynote Sessions</span
            >
          </div>
          <div class="border-l-2 border-primary pl-4">
            <span
              class="text-3xl font-extrabold text-primary tracking-tight block"
              >100+</span
            >
            <span
              class="text-[10px] text-slate-500 font-bold uppercase tracking-wider"
              >Accepted Papers</span
            >
          </div>
        </div>
      </div>

      <!-- About Graphics / Visual Card -->
      <div class="academic-card p-6 bg-white border border-slate-200">
        <h3
          class="text-primary font-bold text-sm uppercase tracking-wider mb-4 border-b border-slate-100 pb-2"
        >
          Host Institution
        </h3>
        <p class="text-xs text-slate-700 leading-relaxed mb-4">
          <strong
            >International Institute of Professional Studies (IIPS), DAVV</strong
          > is a premier business-computer study center established in 1992 under
          Devi Ahilya Vishwavidyalaya. It is known for running highly integrated professional
          programs in management and computer applications.
        </p>
        <div class="mt-4 border-t border-slate-100 pt-4 space-y-2.5 text-xs text-slate-650">
          <div class="flex items-start gap-2.5">
            <span class="text-primary font-bold">✓</span>
            <span><strong>Established:</strong> 1992 (celebrating over 3 decades of academic excellence).</span>
          </div>
          <div class="flex items-start gap-2.5">
            <span class="text-primary font-bold">✓</span>
            <span><strong>Campus:</strong> Housed within the central Takshashila Campus of DAVV Indore.</span>
          </div>
          <div class="flex items-start gap-2.5">
            <span class="text-primary font-bold">✓</span>
            <span><strong>Focus:</strong> A state-of-the-art study center combining computer applications, information technology, and management research.</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Keynote Speakers -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16 space-y-3">
        <span
          class="text-xs font-bold tracking-wider text-primary uppercase block"
          >Keynotes</span
        >
        <h2
          class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight"
        >
          Distinguished Speakers
        </h2>
        <p class="text-slate-500 text-xs sm:text-sm">
          Hear from world-renowned researchers paving the way for innovations in
          artificial intelligence, hardware design, and cryptology.
        </p>
      </div>

      <!-- Speakers Grid -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {
          keynoteSpeakers.map((speaker) => (
            <div class="academic-card bg-white p-6 flex flex-col items-center text-center h-full border border-slate-200">
              <div class="w-40 h-40 rounded-[4px] border border-slate-200 overflow-hidden bg-slate-50 mb-4 flex items-center justify-center shrink-0 shadow-sm">
                <img
                  src={speaker.image}
                  alt={speaker.name}
                  class="w-full h-full object-cover"
                />
              </div>
              <div class="flex-grow flex flex-col justify-between">
                <div>
                  <span class="text-[9px] text-primary font-bold uppercase tracking-wider block mb-1">
                    {speaker.role}
                  </span>
                  <h3 class="text-slate-900 font-extrabold text-base tracking-wide mb-0.5">
                    {speaker.name}
                  </h3>
                  <p class="text-xs text-slate-500 font-semibold mb-3">
                    {speaker.institution}
                  </p>
                  <div class="h-[1px] w-12 bg-slate-200 mx-auto mb-3" />
                  <p class="text-xs text-slate-600 leading-relaxed italic">
                    <strong>Talk title:</strong> "{speaker.topic}"
                  </p>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Layout>

<script>
  let currentSlide = 0;
  const slides = document.querySelectorAll('.hero-slide');
  if (slides.length > 0) {
    setInterval(() => {
      slides[currentSlide].classList.remove('opacity-100');
      slides[currentSlide].classList.add('opacity-0');
      currentSlide = (currentSlide + 1) % slides.length;
      slides[currentSlide].classList.remove('opacity-0');
      slides[currentSlide].classList.add('opacity-100');
    }, 5000);
  }
</script>

