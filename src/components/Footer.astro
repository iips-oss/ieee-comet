---
const currentYear = new Date().getFullYear();
---

<footer class="bg-slate-100 border-t border-slate-200 pt-16 pb-8 text-slate-600 text-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10 mb-12">
      <!-- Column 1: Conference Info -->
      <div class="space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-8 h-8 bg-primary flex items-center justify-center font-bold text-white text-md rounded-[4px]">
            C
          </div>
          <span class="text-primary font-bold tracking-wide text-lg">IIPS-CoMET 2026</span>
        </div>
        <p class="text-xs leading-relaxed text-slate-500">
          The IEEE International Conference on Modern Emerging Technologies (IIPS-CoMET 2026) is organized by the International Institute of Professional Studies, DAVV, Indore, India.
        </p>
        <p class="text-xs text-slate-500">
          Technical Co-sponsorship by IEEE (applied for).
        </p>
      </div>

      <!-- Column 2: Quick Links -->
      <div>
        <h3 class="text-primary font-bold tracking-wider uppercase text-xs mb-4">Quick Links</h3>
        <ul class="space-y-2.5 text-xs">
          <li><a href="/call-for-papers" class="hover:text-primary transition-colors">Call for Papers</a></li>
          <li><a href="/committees" class="hover:text-primary transition-colors">Organizing Committee</a></li>
          <li><a href="/dates" class="hover:text-primary transition-colors">Important Dates</a></li>
          <li><a href="/registration" class="hover:text-primary transition-colors">Registration Details</a></li>
          <li><a href="/venue" class="hover:text-primary transition-colors">Venue & Accommodation</a></li>
        </ul>
      </div>

      <!-- Column 3: Resources -->
      <div>
        <h3 class="text-primary font-bold tracking-wider uppercase text-xs mb-4">Resources</h3>
        <ul class="space-y-2.5 text-xs">
          <li>
            <a href="https://template-selector.ieee.org/" target="_blank" rel="noopener noreferrer" class="hover:text-primary transition-colors flex items-center gap-1.5">
              IEEE Paper Templates
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
            </a>
          </li>
          <li>
            <a href="https://www.ieee.org/" target="_blank" rel="noopener noreferrer" class="hover:text-primary transition-colors flex items-center gap-1.5">
              IEEE Official Site
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
            </a>
          </li>
          <li>
            <a href="#" class="hover:text-primary transition-colors flex items-center gap-1.5">
              Submission Portal (CMT)
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
            </a>
          </li>
          <li><a href="/contact" class="hover:text-primary transition-colors">Query / Feedback</a></li>
        </ul>
      </div>

      <!-- Column 4: Contact & Venue -->
      <div class="space-y-3">
        <h3 class="text-primary font-bold tracking-wider uppercase text-xs mb-4">Venue Address</h3>
        <p class="text-xs text-slate-500 leading-relaxed">
          International Institute of Professional Studies (IIPS),<br />
          Devi Ahilya Vishwavidyalaya (DAVV), Takshashila Campus, Khandwa Road,<br />
          Indore, Madhya Pradesh, India - 452001
        </p>
        <div class="flex items-center gap-2 pt-2 text-xs">
          <span class="text-primary font-semibold">Email:</span>
          <a href="mailto:comet@iips.edu.in" class="text-slate-700 hover:text-primary transition-colors font-mono">comet@iips.edu.in</a>
        </div>
      </div>
    </div>

    <!-- Divider -->
    <div class="border-t border-slate-200 my-8"></div>

    <!-- Bottom Section: IEEE Legal Requirements and Copyright -->
    <div class="flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-slate-500">
      <div>
        <p>&copy; {currentYear} IIPS-CoMET. All Rights Reserved. Organized by IIPS, DAVV.</p>
      </div>
      
      <!-- IEEE Standard Legal Policies -->
      <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2">
        <a href="https://www.ieee.org/security-privacy.html" target="_blank" rel="noopener noreferrer" class="hover:text-primary transition-colors">IEEE Privacy Policy</a>
        <a href="https://www.ieee.org/about/corporate/compliance/nondiscrimination.html" target="_blank" rel="noopener noreferrer" class="hover:text-primary transition-colors">IEEE Nondiscrimination Policy</a>
        <a href="https://www.ieee.org/about/help/site-terms-conditions.html" target="_blank" rel="noopener noreferrer" class="hover:text-primary transition-colors">Terms and Conditions</a>
        <a href="https://www.ieee.org/accessibility-statement.html" target="_blank" rel="noopener noreferrer" class="hover:text-primary transition-colors">IEEE Accessibility Statement</a>
      </div>
    </div>
  </div>
</footer>
