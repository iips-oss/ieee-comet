---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  activePage?: string;
}

const { 
  title, 
  description = "IEEE Conference on Modern Emerging Technologies (IIPS-CoMET) organized by IIPS, Devi Ahilya Vishwavidyalaya, Indore.",
  activePage 
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Primary Meta Tags -->
    <title>{title} | IIPS-CoMET 2026</title>
    <meta name="title" content={`${title} | IIPS-CoMET 2026`} />
    <meta name="description" content={description} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} | IIPS-CoMET 2026`} />
    <meta property="og:description" content={description} />
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={`${title} | IIPS-CoMET 2026`} />
    <meta property="twitter:description" content={description} />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  </head>
  <body class="bg-bg-body text-text-main min-h-screen flex flex-col antialiased">
    <!-- Main Navbar -->
    <Navbar activePage={activePage} />
    
    <!-- Page Main Content -->
    <main class="flex-grow">
      <slot />
    </main>

    <!-- Footer -->
    <Footer />

    <!-- Back to Top Button -->
    <button 
      id="back-to-top" 
      class="fixed bottom-8 right-8 z-50 p-2.5 rounded-[4px] bg-primary text-white shadow-md opacity-0 translate-y-10 pointer-events-none hover:bg-primary-dark transition-all duration-300 border border-primary-dark"
      aria-label="Back to top"
    >
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 10l7-7m0 0l7 7m-7-7v18" />
      </svg>
    </button>

    <script>
      // Back to top behavior
      const backToTopBtn = document.getElementById('back-to-top');
      if (backToTopBtn) {
        window.addEventListener('scroll', () => {
          if (window.scrollY > 300) {
            backToTopBtn.classList.remove('opacity-0', 'translate-y-10', 'pointer-events-none');
            backToTopBtn.classList.add('opacity-100', 'translate-y-0', 'pointer-events-auto');
          } else {
            backToTopBtn.classList.remove('opacity-100', 'translate-y-0', 'pointer-events-auto');
            backToTopBtn.classList.add('opacity-0', 'translate-y-10', 'pointer-events-none');
          }
        });

        backToTopBtn.addEventListener('click', () => {
          window.scrollTo({
            top: 0,
            behavior: 'smooth'
          });
        });
      }
    </script>
  </body>
</html>
